; A fin 20 x 4 x t mm along x from a 4 x 6 x 6 block, held at x < 1, E 200 GPa, nu 0, 1e-5 N at its tip (x > 19), t 0.1, its mid-plane at z 0.1; yield 250 MPa.
; truth: stiff fails about 0.0001952 (cantilever, F L^3 / 3 E I over the free 16 mm)
; truth: strong fails about 0.02175 (beam, 6 M / b t^2 1 mm from the root)
; truth: safe fails about 1.149e+04 (yield over the beam stress)
(import "std") (def part (min (move (box 4 6 6) 2 0 0) (move (box 20 4 0.1) 10.0 0 0.1)))
(study s (shape part) (elastic (E 200000MPa) (nu 0) (yield 250MPa)) (fix root (- x 1)) (load tip (force 0 0 -1e-05N) (region (- 19 x))) )
(require stiff (max-displacement s < 1.6e-4))
(require strong (max-stress s < 0.0109MPa))
(require safe (min-safety-factor s > 22936))
