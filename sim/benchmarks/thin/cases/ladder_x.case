; A ladder tower along x: two 1.5 mm square rods at y +-4, three storeys of 25 mm, 8 x 12 x 10 floors, clamped at x < 0.5, the top floor pushed 103.8 N.
; Rods in line through small thick blocks buckle as one long column: each rod alone looks stocky.
; truth: safe fails at most 1 (it buckles at 0.5000 of the load: ink's eigensolve; a static safety factor says nothing of that)
; truth: stiff fails at least 1 (past its buckling load: no stable position near the unloaded one)
(import "std")
(def part (min (min (min (min (min (min (min (min (move (box 25 1.5 1.5) 12.5 -4 0) (move (box 25 1.5 1.5) 12.5 4 0)) (move (box 25 1.5 1.5) 45.5 -4 0)) (move (box 25 1.5 1.5) 45.5 4 0)) (move (box 25 1.5 1.5) 78.5 -4 0)) (move (box 25 1.5 1.5) 78.5 4 0)) (move (box 8 12 10) 29.0 0 0)) (move (box 8 12 10) 62.0 0 0)) (move (box 8 12 10) 95.0 0 0)))
(study s (shape part) (elastic (E 200000MPa) (nu 0.3) (yield 1000MPa)) (fix base (- x 0.5))
  (load push (force -103.8N 0 0) (region (- 98.5 x))) (res 0.5))
(require safe (min-safety-factor s > 2 (excluding support-margin)))
(require stiff (max-displacement s < 1))
