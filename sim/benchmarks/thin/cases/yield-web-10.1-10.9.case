; Two 10 x 6 x 6 blocks joined across a gap by a web 0.3 mm thick and 6 wide, 1 mm cells, pulled apart by 1 N, yield 10 MPa over x 10.1 to 10.9 (in the web) and 250 elsewhere.
; truth: safe fails about 1.47 (0.1 mm cells (yield-web-r0.1); statics gives 10 / 0.556 = 18 at most)
(import "std")
(def part (min (move (box 10 6 6) 5 0 0) (move (box 10 6 6) 16 0 0) (move (box 2 6 0.3) 10.5 0 0.5)))
(study s (shape part) (elastic (E 200000MPa) (nu 0) (yield (* 1MPa (select (max (- 10.1 x) (- x 10.9)) 10 250)))) (fix root (- x 1)) (load pull (force 1N 0 0) (region (- 20 x))) (res 1))
(require safe (min-safety-factor s > 10))
