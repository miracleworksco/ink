; A fin 20 x 4 x t mm along x from a 4 x 6 x 6 block, held at x < 1, E 200 GPa, nu 0, 1e-5 N at its tip (x > 19), t 0.1, turned 45 deg about x, raised 0 mm.
; truth: strong fails about 0.02175 (beam, 6 M / b t^2 1 mm from the root)
(import "std") (def part (min (move (box 4 6 6) 2 0 0) (move (rotate-x (move (box 20 4 0.1) 10 0 0) 45) 0 0 0)))
(study s (shape part) (elastic (E 200000MPa) (nu 0)) (fix root (- x 1)) (load tip (force 0 7.0710678118654756e-06N -7.071067811865476e-06N) (region (- 19 x))) (res 1.0))
(require strong (max-stress s < 0.010875MPa))
