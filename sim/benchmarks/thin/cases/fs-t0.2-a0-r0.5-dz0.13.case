; A fin 20 x 4 x t mm along x from a 4 x 6 x 6 block, held at x < 1, E 200 GPa, nu 0, 1e-5 N at its tip (x > 19), t 0.2, turned 0 deg about x, raised 0.13 mm.
; truth: strong fails about 0.005437 (beam, 6 M / b t^2 1 mm from the root)
(import "std") (def part (min (move (box 4 6 6) 2 0 0) (move (rotate-x (move (box 20 4 0.2) 10 0 0) 0) 0 0 0.13)))
(study s (shape part) (elastic (E 200000MPa) (nu 0)) (fix root (- x 1)) (load tip (force 0 0.0 -1e-05N) (region (- 19 x))) (res 0.5))
(require strong (max-stress s < 0.0027187MPa))
