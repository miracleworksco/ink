; A 20 x 4 x 4 steel bar with a slit at x 5.1 leaving a ligament thinner than a cell, 1e-5 N at its tip.
; truth: stiff fails at least 8.304e-06 (0.05 to 0.0625 mm cells, still rising as they shrink)
(import "std") (def part (move (subtract (move (box 20 4 4) 10 0 0) (move (box 0.4 8 3.875) 5.1 0 0.0625)) 0 0 0.03))
(study s (shape part) (elastic (material steel)) (fix root (- x 1)) (load tip (force 0 0 -0.00001N) (region (- 19 x))) (res 0.5))
(require stiff (max-displacement s < 7.5e-6))
