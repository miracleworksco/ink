; A 0.3 mm web joining a 2 mm block, held at x < 1, to a 10 mm block pulled by 1 N: the web lies in the fix's support margin.
; truth: strong fails at least 3.1 (0.1 mm cells (support-thin-r0.1): 3.1 outside the margin, 12.9 within)
(import "std")
(def part (min (move (box 2 6 6) 1.0 0 0) (move (box 10 6 6) 8 0 0) (move (box 2 6 .3) 2.5 0 .5)))
(study s (shape part) (elastic (E 200000MPa) (nu 0) (yield 250MPa))
 (fix root (- x 1)) (load pull (force 1N 0 0) (region (- 12 x))) (res 1))
(require strong (max-stress s < .8MPa))
