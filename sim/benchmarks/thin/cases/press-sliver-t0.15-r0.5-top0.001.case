; A fin 20 x 4 x 0.15 mm from a 4 x 6 x 6 block, its top face at z 0.001: just above a plane of the split cells,
; so the child cell holding that face holds a sliver and is dropped. A pressure 0.001 MPa on the top face (x > 4.5):
; 0.001 x 15.5 x 4 = 0.062 N down (the solve's loads total says what it applied). E 200 GPa, nu 0.
; truth: stiff fails about 0.1456 (beam q L^4 / 8 E I, q 0.004 N/mm, L 16)
; truth: strong fails at least 32.03 (beam 6 M / b t^2 at x 4.5, M = q 15.5^2 / 2)
(import "std")
(def part (min (move (box 4 6 6) 2 0 0) (move (box 20 4 0.15) 10 0 -0.074)))
(study s (shape part) (elastic (E 200000MPa) (nu 0)) (fix root (- x 1))
  (load top (pressure 0.001MPa) (region (max (- -0.074 z) (- 4.5 x)))) (res 0.5))
(require stiff (max-displacement s < 0.07282))
(require strong (max-stress s < 16.02MPa (excluding support-margin)))
