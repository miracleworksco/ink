; A cantilever 20 x 2 x 0.5 from a block, held at x < -3.99, 0.01 N down at its tip, on 0.25 mm cells; 28 rods 0.03 mm square
; under it in four rows (z -0.25 to -1, y 0.25 to 1.75), joined to it only at its root (the block) and its tip (a tab). Each rod
; lies between the lines through the samples on cells of 1, 0.5 and 0.25 mm and is written as the root of a distance, so no
; sample's tangent plane reaches it: the planes through the samples find it, but within a cell of the beam's cells, so
; touching them all along, it was taken as the beam's own surface, and the beam alone was read, 0.0065.
; truth: stiff holds about 0.0040 (beam theory: the rods hold the tip's turn as a spring of E A d^2 / L, 1.02 times the beam's E I / L, so the tip moves 1 - 0.75 x 1.02 / 2.02 = 0.62 of the beam alone's 0.0065)
(import "std")
(def block (move (box 4 2 4.5) -2 1 0.25))
(def beam (move (box 20 2 0.5) 10 1 0.25))
(def tab (move (box 0.5 2 1.1) 19.75 1 -0.55))
(def rods (min (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.25 -0.25))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.5 -0.25))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.75 -0.25))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.0 -0.25))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.25 -0.25))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.5 -0.25))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.75 -0.25))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.25 -0.5))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.5 -0.5))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.75 -0.5))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.0 -0.5))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.25 -0.5))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.5 -0.5))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.75 -0.5))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.25 -0.75))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.5 -0.75))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.75 -0.75))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.0 -0.75))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.25 -0.75))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.5 -0.75))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.75 -0.75))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.25 -1.0))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.5 -1.0))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 0.75 -1.0))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.0 -1.0))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.25 -1.0))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.5 -1.0))) (sqrt (max 0 (move (box 20.4 0.03 0.03) 9.7 1.75 -1.0)))))
(study s (shape (min block beam tab rods)) (elastic (E 200000MPa) (nu 0.3)) (fix root (- x -3.99)) (load tip (force 0 0 -0.01N) (region (- 19.9 x))) (res 0.25))
(require stiff (max-displacement s < 0.005))
