; A sheet 20 x 4 x 0.189 mm lying on z = 0 (z 0 to 0.189) from a 4 x 6 x 6 block, held at x < 1; a pressure 0.001 MPa
; on its top face (x > 4.5): 0.062 N down. At res 0.5 the sheet splits to 0.0625 mm cells; its top face lies 0.0015 mm
; past their plane at 0.1875, in a child under 3% full (dropped).
; truth: stiff fails about 0.0728 (beam q L^4 / 8 E I, q 0.004 N/mm, L 16)
; truth: strong fails at least 20.18 (beam 6 M / b t^2 at x 4.5)
(import "std")
(def part (min (move (box 4 6 6) 2 0 0) (move (box 20 4 0.189) 10 0 0.0945)))
(study s (shape part) (elastic (E 200000MPa) (nu 0)) (fix root (- x 1))
  (load top (pressure 0.001MPa) (region (max (- 0.0945 z) (- 4.5 x)))) (res 0.5))
(require stiff (max-displacement s < 0.0364))
(require strong (max-stress s < 10.09MPa (excluding support-margin)))
