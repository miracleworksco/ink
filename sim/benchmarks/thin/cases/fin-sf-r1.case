; The 0.1 mm fin, its mid-plane 0.13 mm off a plane of the cells, on 1 mm cells, yield 250 MPa.
; truth: safe holds about 1.1e+04 (yield over the beam stress at the root)
(import "std") (def part (min (move (box 4 6 6) 2 0 0) (move (box 20 4 0.1) 10.0 0 0.13)))
(study s (shape part) (elastic (E 200000MPa) (nu 0) (yield 250MPa)) (fix root (- x 1)) (load tip (force 0 0 -1e-05N) (region (- 19 x))) (res 1))
(require safe (min-safety-factor s > 100))
