; Five 1.5 mm square rods 30 long joined in line by four 14 mm cubes (206 long), clamped at x < 0.5, the tip pushed 13.6 N; at the cells ink picks.
; Rods in line through small thick blocks buckle as one long column: each rod alone looks stocky.
; truth: safe fails at most 1 (it buckles at 0.5001 of the load: ink's eigensolve; a static safety factor says nothing of that)
; truth: stiff fails at least 1 (past its buckling load: no stable position near the unloaded one)
(import "std")
(def part (min (min (min (min (min (min (min (min (move (box 30 1.5 1.5) 15.0 0 0) (move (box 14 14 14) 37.0 0 0)) (move (box 30 1.5 1.5) 59.0 0 0)) (move (box 14 14 14) 81.0 0 0)) (move (box 30 1.5 1.5) 103.0 0 0)) (move (box 14 14 14) 125.0 0 0)) (move (box 30 1.5 1.5) 147.0 0 0)) (move (box 14 14 14) 169.0 0 0)) (move (box 30 1.5 1.5) 191.0 0 0)))
(study s (shape part) (elastic (E 200000MPa) (nu 0.3) (yield 1000MPa)) (fix base (- x 0.5))
  (load push (force -13.6N 0 0) (region (- 205.5 x))))
(require safe (min-safety-factor s > 2 (excluding support-margin)))
(require stiff (max-displacement s < 1))
