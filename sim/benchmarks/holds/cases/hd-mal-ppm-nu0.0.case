(import "std")
(def part (move (rotate-z (move (box 204 7.2 4.8) 102.0 0 0) 0.0) 0 0 0))
(study s (shape part) (elastic (E 200000MPa) (nu 0.0) (density 7850kg/m3))
  (fix pin (- (+ (* 1.0 (- x 0)) (* 0.0 (- y 0))) 1e-06) (pivot (at 0.0 0.0 0) (axis -0.0 1.0 0)))
  (fix pin2 (- 203.999999 (+ (* 1.0 (- x 0)) (* 0.0 (- y 0)))) (pivot (at 204.0 0.0 0) (axis -0.0 1.0 0)))
  (modes 6)
  (res 0.6))
(require q (min-frequency s > 0Hz))
