; tube ri 3 ro 8.3 height 2.2; convection 500 W/m2/K from 100 C in the bore, 50 to 20 C outside; k 1; res 0.7
; exact radial: q' = (Ta-Tb)/(1/(h1 2 pi ri) + ln(ro/ri)/(2 pi k) + 1/(h2 2 pi ro)) = 122.78 W/m; bore wall Tmax = Ta - q'/(h1 2 pi ri) = 86.9726 C
(import "std")
(body t (shape (subtract (cylinder-z 8.3 2.2) (cylinder-z 3 4.2))))
(study s (shape (shape-of t)) (heat (k 1W/m/K))
  (convection hot (max (- (len2 x y) 3.15) (- (abs z) 1.0990000000000002)) (coefficient 500W/m2/K) (ambient 100degC))
  (convection cold (max (- 8.15 (len2 x y)) (- (abs z) 1.0990000000000002)) (coefficient 50W/m2/K) (ambient 20degC))
  (res 0.7))
(require temp (max-temperature s < 1e6degC))
