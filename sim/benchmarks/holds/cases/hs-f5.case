; bar 12.3 x 2.2 x 1.9 along x from 0, turned 3 deg about y, moved (0, 0, 0); clamped over its first 0.5 mm; end face loaded (force 41.742714552741184N 0 -2.1876429709550522N); E 1000, nu 0; res 0.3
; exact: stress 10 MPa everywhere past the clamp (nu 0: exact for any clamp length)
(import "std")
(body bar (shape (move (rotate-y (move (box 12.3 2.2 1.9) 6.15 0 0) 3) 0 0 0)))
(study s (shape (shape-of bar)) (elastic (E 1000MPa) (nu 0))
  (fix wall (- (- (* 0.9986295347545738 (- x 0)) (* 0.052335956242943835 (- z 0))) 0.5))
  (load p (force 41.742714552741184N 0 -2.1876429709550522N) (region (- 11.3 (- (* 0.9986295347545738 (- x 0)) (* 0.052335956242943835 (- z 0))))))
  (res 0.3) )
(require stress (max-stress s < 100000MPa))
