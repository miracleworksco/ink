(study s (shape part) (elastic (E 200000MPa) (nu 0.0))
  (fix pin (- (+ (* 1.0 (- x 13.0)) (* 0.0 (- y 17.0))) 9.999999999999999e-05) (pivot (at 13.0 17.0 23.0) (axis -0.0 1.0 0)))
  (fix roller (- 20399.9999 (+ (* 1.0 (- x 13.0)) (* 0.0 (- y 17.0)))) (pivot (at 20413.0 17.0 23.0) (axis -0.0 1.0 0)) (slide 1.0 0.0 0))
  (load push (force -1000000.0N -0.0N 0.0N) (region (- 20399.9999 (+ (* 1.0 (- x 13.0)) (* 0.0 (- y 17.0))))))
  (res 60.0))
(require q (min-buckling-factor s > 0))
