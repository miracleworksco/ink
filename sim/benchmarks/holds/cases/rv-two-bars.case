(import "std")
(def b1 (move (box 20 4 4) 10 0 0))
(def b2 (move (box 20 4 4) 10 8 0))
(def bar (min b1 b2))
(study s (shape bar) (elastic (E 1000MPa) (nu 0))
  (fix wall (min (max (- (abs (- x 0.07)) 0.04) (- y 3)) (max (- (abs (- x 0.14)) 0.06) (- 5 y))))
  (load t1 (pressure -10MPa) (region (face b1 (normal 1 0 0))))
  (load t2 (pressure -9.58048MPa) (region (face b2 (normal 1 0 0)))) (res 0.5))
(require d (max-displacement s < 1000mm))
