; round shaft radius 2.1, length 14 along z from 0, turned 5 deg about y; clamped over its first 0.5 mm, 100 N mm of torque on its last mm; nu 0.3; res 0.3
; exact (away from the ends): shear 2T/(pi r^3), von Mises sqrt3 that = 11.9065 MPa
(import "std")
(body sh (shape (rotate-y (move (cylinder-z 2.1 14) 0 0 7.0) 5)))
(study s (shape (shape-of sh)) (elastic (E 1000MPa) (nu 0.3))
  (fix wall (- (+ (* 0.08715574274765817 x) (* 0.9961946980917455 z)) 0.5))
  (load tq (torque 8.715574274765817N*mm 0 99.61946980917456N*mm) (region (- 13 (+ (* 0.08715574274765817 x) (* 0.9961946980917455 z)))))
  (res 0.3))
(require stress (max-stress s < 100000MPa))
(require lo (max-stress s > 10.48MPa))
(require hi (max-stress s < 14.88MPa))
