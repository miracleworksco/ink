(import "std")
(def part (move (rotate-z (move (box 408 7.2 4.8) 204.0 0 0) 0.0) 0 0 0))
(study s (shape part) (elastic (E 200000MPa) (nu 0.3))
  (fix pin (- (+ (* 1.0 (- x 0)) (* 0.0 (- y 0))) 1e-06) (pivot (at 0.0 0.0 0) (axis -0.0 1.0 0)))
  (fix roller (- 407.999999 (+ (* 1.0 (- x 0)) (* 0.0 (- y 0)))) (pivot (at 408.0 0.0 0) (axis -0.0 1.0 0)) (slide 1.0 0.0 0))
  (load push (force -10.0N -0.0N 0.0N) (region (- 407.999999 (+ (* 1.0 (- x 0)) (* 0.0 (- y 0))))))
  (res 0.6))
(require q (min-buckling-factor s > 0))
