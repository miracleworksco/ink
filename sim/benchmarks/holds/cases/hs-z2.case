; bar 0.72 x 0.24 x 0.18, mirrors on its low faces, 0.432 N spread past x = 0.66, E 200000, nu 0, res 0.03
; exact: stress 10.0 MPa to x=0.66; tip F a/(AE) + F (L-a)/(2AE) = 3.45e-05 mm
(import "std")
(body bar (shape (move (box 0.72 0.24 0.18) 0.36 0.12 0.09)))
(study s (shape (shape-of bar)) (elastic (E 200000MPa) (nu 0))
  (mirror mx x 0) (mirror my y 0) (mirror mz z 0) (load f (force 0.43199999999999994N 0 0) (region (- 0.66 x))) (res 0.03))
(require stress (max-stress s < 100000MPa))
(require disp (max-displacement s < 100000))
(require comp (compliance s < 1e9N*mm))
