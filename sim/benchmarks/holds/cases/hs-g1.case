; column 2.1 x 1.8 x 8.1 tall standing on a roller floor, quarter by mirrors x0 y0, own weight, density 7850, E 1 MPa, nu 0, res 0.3
; exact: stress at the floor rho g L = 0.000623769 MPa; top sinks rho g L^2/(2E) = 0.00252626 mm; compliance rho^2 g^2 A L^3/(3E) = 3.97103e-06 N mm
(import "std")
(body bar (shape (move (box 2.1 1.8 8.1) 1.05 0.9 4.05)))
(study s (shape (shape-of bar)) (elastic (E 1MPa) (nu 0) (density 7850kg/m3))
  (mirror mx x 0) (mirror my y 0) (fix floor (- z 0.01) (dofs z) (support)) (gravity 0 0 -9.81m/s2) (res 0.3))
(require stress (max-stress s < 100000MPa))
(require disp (max-displacement s < 100000))
(require comp (compliance s < 1e9N*mm))
