; bar 12.3 x 2.2 x 1.9 along x from 0, turned 0 deg about z, moved (0.17, -0.41, 3.33); clamped over its first 0.5 mm; end face loaded (torque -0.0N*mm 12.57483333333333N*mm 0); E 1000, nu 0; res 0.3
; exact: pure bending by an end couple M = k I, away from the ends (Saint-Venant), stress k c = 9.5 MPa on the faces z' = +-0.95 (nu 0: exact for any clamp length)
(import "std")
(body bar (shape (move (rotate-z (move (box 12.3 2.2 1.9) 6.15 0 0) 0) 0.17 -0.41 3.33)))
(study s (shape (shape-of bar)) (elastic (E 1000MPa) (nu 0))
  (fix wall (- (+ (* 1.0 (- x 0.17)) (* 0.0 (- y -0.41))) 0.5))
  (load p (torque -0.0N*mm 12.57483333333333N*mm 0) (region (- 11.3 (+ (* 1.0 (- x 0.17)) (* 0.0 (- y -0.41))))))
  (res 0.3) )
(require stress (max-stress s < 100000MPa))
