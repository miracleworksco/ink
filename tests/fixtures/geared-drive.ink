(import "std")
(body rotor (shape (cylinder-z 3.9 80)) (frame shaft (at (move 0 0 35))))
(assembly (drive (angle 0)) (instance rotor rotor (at) (turn z angle))
  (frame shaft (frame-of rotor shaft)))
(t-span 0 1)
(def zp 15) (def zw 45) (def module 1) (def backlash .1) (def face 8)
(fn gear (teeth bore)
  (subtract (extrude-z (involute-gear-2d teeth module 20 backlash) 0 face) (cylinder-z (* .5 bore) 20)))
(body pinion (shape (gear zp 8)))
(body wheel (shape (gear zw 8)))
(fn motor-turn (output-rpm) (* (neg (/ zw zp)) .5 (* output-rpm 1rpm) (square t)))
(assembly (gearbox (output-rpm 0))
  (instance m (drive (motor-turn output-rpm)))
  (instance p pinion (at (move 0 0 -30) (frame-of m shaft)))
  (instance w wheel (at (move (mesh-distance zp zw module) 0 5))
    (turn z (mesh-turn zp zw 0 (motor-turn output-rpm))))
  (relate p w (gear-mesh zp zw module 20 (* 2 backlash))))
(assembly root (instance fast (gearbox 2000)))
